{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "preinstall": "npx --yes only-allow pnpm",
    "build": "pnpm run typecheck && pnpm --filter @workspace/know-your-world run build",
    "typecheck": "pnpm --filter @workspace/know-your-world run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "prettier --check ."
  },
  "private": true,
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  }
}
