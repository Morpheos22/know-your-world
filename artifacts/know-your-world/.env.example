# Cloudflare Worker base URL (where the API lives)
VITE_API_BASE=https://know-your-world-api.morphylee22.workers.dev

# Supabase project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase publishable (anon) key — safe to expose, gated by RLS policies.
# NOT the service-role / secret key.
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cloudflare Turnstile sitekey (the public-facing sitekey shown to users)
VITE_TURNSTILE_SITEKEY=0x4AAAAAAA_xxxxxxxxxxxxxxxxx
